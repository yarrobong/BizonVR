# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных (выберите один способ)
# Способ 1: отдельные переменные (локальная разработка)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bizon
DB_USER=postgres
DB_PASSWORD=Ispector228!
DB_HOST=localhost
# Порт 5434 — PostgreSQL в Docker (в docker-compose проброшен 5434:5432)
DB_PORT=5434

# Способ 2: одна строка (облако, Heroku и т.п.) — имеет приоритет над DB_*
# DATABASE_URL=postgres://user:password@host:5432/dbname

# SMS (Фаза 2 — подтверждение по телефону)
# SMS_PROVIDER=smsru
# SMS_API_KEY=your-sms-api-key
# SMS_SENDER=BizonVR

# NowPayments (Фаза 5 — криптоплатежи)
