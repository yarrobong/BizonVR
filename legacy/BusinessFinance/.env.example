# Скопируйте в .env и измените под вашу установку PostgreSQL.

# Docker (docker compose up -d). Порт 5433 — чтобы не конфликтовать с локальным Postgres на 5432.
DATABASE_URL=postgresql://finance:finance@localhost:5433/finance

# Либо локальный PostgreSQL (пользователь postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Пароль первого админа (логин admin). Меняется в Настройки → Пользователи.
ADMIN_INITIAL_PASSWORD=admin

# Секрет для шифрования cookie сессии (опционально). Менять в проде.
# COOKIE_SECRET=your-random-secret

# Срок жизни сессии в днях (опционально, по умолчанию 7).
# SESSION_EXPIRE_DAYS=7
