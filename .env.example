# =============================================================================
# Локальная разработка
# =============================================================================
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных — PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bizon
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
# При работе с БД в Docker: DB_HOST=db, DB_PORT=5432; на хосте порт 5434
DB_PORT=5434

# Облако / Heroku — одна строка (имеет приоритет над DB_*)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# SMS (подтверждение по телефону). Без ключа код пишется в лог.
# SMS_PROVIDER=smsru
# SMS_API_KEY=your-sms-ru-api-id

# NowPayments (криптоплатежи)
# NOWPAYMENTS_API_KEY=...
# NOWPAYMENTS_IPN_SECRET=...
# SITE_URL=https://bizonvr.ru

# =============================================================================
# ПРОДАКШЕН (скопируйте на сервер как .env и задайте значения)
# =============================================================================
# SECRET_KEY=сгенерируйте-уникальный-ключ-50-символов
# DEBUG=False
# ALLOWED_HOSTS=bizonvr.ru,www.bizonvr.ru
# CSRF_TRUSTED_ORIGINS=https://bizonvr.ru,https://www.bizonvr.ru
# USE_HTTPS=true
# SITE_URL=https://bizonvr.ru
# DB_HOST=db
# DB_PORT=5432
# DB_PASSWORD=надёжный-пароль
# GUNICORN_WORKERS=2
