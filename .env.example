SECRET_KEY=your-secret-key-here
DEBUG=True
# На продакшене: bizonvr.ru, www.bizonvr.ru и 127.0.0.1 (нужен, если Nginx проксирует на localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,bizonvr.ru,www.bizonvr.ru

# На хостинге обязательно задать: иначе в КП и письмах будет localhost:8000
SITE_URL=https://bizonvr.ru
# Для форм и логина по HTTPS (через запятую, без пробелов после запятой)
CSRF_TRUSTED_ORIGINS=https://bizonvr.ru,https://www.bizonvr.ru
USE_HTTPS=False
TEST_ORDER_NO_PAYMENT=0

# Одна БД PostgreSQL. Имя — только в нижнем регистре (bizon), иначе будет ошибка "database does not exist"
DB_NAME=bizon
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5434

PORT=8001
GUNICORN_WORKERS=2
CACHE_REDIS_URL=
TRUSTED_PROXY_IPS=

# Продакшен-интеграции (заполнить перед запуском)
SMS_PROVIDER=smsru
SMS_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Внешние ссылки в меню/баннерах (если пусто, пункты скрываются)
SITE_BLOG_URL=
SITE_CLUBS_URL=
SITE_INSTRUCTIONS_URL=
SITE_YOUTUBE_URL=
SITE_TIKTOK_URL=

# Не включать в продакшене, если медиа отдает Nginx
SERVE_MEDIA=0
