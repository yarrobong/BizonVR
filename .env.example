SECRET_KEY=your-secret-key-here
DEBUG=True
# На продакшене: bizonvr.ru, www.bizonvr.ru и 127.0.0.1 (нужен, если Nginx проксирует на localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,bizonvr.ru,www.bizonvr.ru

# На хостинге обязательно задать: иначе в КП и письмах будет localhost:8000
SITE_URL=https://bizonvr.ru
# Для форм и логина по HTTPS (через запятую, без пробелов после запятой)
CSRF_TRUSTED_ORIGINS=https://bizonvr.ru,https://www.bizonvr.ru
# Локально False, на продакшене обязательно True.
USE_HTTPS=False
TEST_ORDER_NO_PAYMENT=0

# Одна БД PostgreSQL. Имя — только в нижнем регистре (bizon), иначе будет ошибка "database does not exist"
DB_NAME=bizon
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

PORT=8000
GUNICORN_WORKERS=2
CACHE_REDIS_URL=
TRUSTED_PROXY_IPS=

# Продакшен-интеграции (заполнить перед запуском)
SMS_PROVIDER=exolve
EXOLVE_API_KEY=
EXOLVE_SENDER=
EXOLVE_API_BASE=https://api.exolve.ru/messaging/v1
SMS_SENDER_NAME=
SMS_MESSAGE_TEMPLATE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
# На продакшене укажите реальную корпоративную почту, например BizonVR <orders@bizonvr.ru>.
DEFAULT_FROM_EMAIL=BizonVR <no-reply@bizonvr.ru>
# Отдельный email Bitrix24/CRM для копий публичных заявок. SMTP-отправителя не меняет.
CRM_LEADS_EMAIL=
EMAIL_VERIFICATION_SUBJECT=Код подтверждения BizonVR
PASSWORD_RESET_EMAIL_SUBJECT=Восстановление пароля BizonVR
PASSWORD_RESET_TIMEOUT=900
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_TTL_MINUTES=15
# Legacy fallback для SMS.ru
SMS_API_KEY=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_IPN_SECRET=
PAYMENT_GATEWAY_API_BASE=
CDEK_WIDGET_ACCOUNT=
CDEK_WIDGET_PASSWORD=
CDEK_WIDGET_API_BASE=https://api.cdek.ru/v2

# Юридические реквизиты для публичных legal pages.
# На продакшене не оставляйте пустыми или с квадратными скобками: manage.py check --deploy остановит запуск.
LEGAL_OPERATOR_FULL_NAME=Индивидуальный предприниматель Едигарьев Ярослав Алексеевич
LEGAL_OPERATOR_SHORT_NAME=ИП Едигарьев Я.А.
LEGAL_OPERATOR_FORM=ИП
LEGAL_OPERATOR_INN=667907832209
LEGAL_OPERATOR_OGRN=325665800130159
LEGAL_OPERATOR_LEGAL_ADDRESS=
LEGAL_OPERATOR_POSTAL_ADDRESS=
LEGAL_OPERATOR_PD_EMAIL=
LEGAL_SIGNATORY_BASIS=действует на основании государственной регистрации в качестве индивидуального предпринимателя
LEGAL_BANK_ACCOUNT=
LEGAL_BANK_NAME=
LEGAL_BANK_BIK=
LEGAL_BANK_INN=
LEGAL_BANK_CORR_ACCOUNT=
LEGAL_BANK_LEGAL_ADDRESS=

# Внешние ссылки в меню/баннерах (если пусто, пункты скрываются)
SITE_BLOG_URL=
SITE_CLUBS_URL=
SITE_INSTRUCTIONS_URL=
SITE_AVITO_URL=https://www.avito.ru/user/a933d26a360016c146b6326f33aa18d1/profile?src=search_seller_info&iid=7888196703
SITE_YOUTUBE_URL=
SITE_TIKTOK_URL=

# Не включать в продакшене, если медиа отдаёт Nginx
SERVE_MEDIA=0
