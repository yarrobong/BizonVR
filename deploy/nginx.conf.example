# Пример конфигурации Nginx для продакшена.
# Основной домен: bizonvr.ru.
# Старый домен bizon-business.ru перенаправляется на главную страницу https://bizonvr.ru/.
# Замените пути к сертификатам/статике/медиа при необходимости.
# Вариант 1: статику и медиа отдаёт Django (WhiteNoise) — тогда location /static/ и /media/ не нужны, всё идёт в proxy_pass.
# Вариант 2: статику/медиа отдаёт Nginx — укажите alias на директории проекта.

upstream bizonvr_app {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name bizonvr.ru www.bizonvr.ru;
    return 301 https://bizonvr.ru$request_uri;
}

server {
    listen 80;
    server_name bizon-business.ru www.bizon-business.ru;
    return 301 https://bizonvr.ru/;
}

server {
    listen 443 ssl http2;
    server_name bizon-business.ru www.bizon-business.ru;

    ssl_certificate     /etc/letsencrypt/live/bizon-business.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bizon-business.ru/privkey.pem;

    return 301 https://bizonvr.ru/;
}

server {
    listen 443 ssl http2;
    server_name bizonvr.ru www.bizonvr.ru;

    ssl_certificate     /etc/letsencrypt/live/bizonvr.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bizonvr.ru/privkey.pem;

    client_max_body_size 20M;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        application/javascript
        application/json
        application/xml
        image/svg+xml;
    # Если модуль brotli доступен в вашей сборке Nginx, можно дополнительно включить:
    # brotli on;
    # brotli_static on;

    location /static/ {
        alias /path/to/bizonvr/staticfiles/;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        gzip_static on;
    }

    location /media/cache/responsive/ {
        alias /path/to/bizonvr/media/cache/responsive/;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /media/ {
        alias /path/to/bizonvr/media/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    location / {
        proxy_pass http://bizonvr_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
